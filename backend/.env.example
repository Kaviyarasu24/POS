# SmartPOS Backend — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# --- Database ---
# SQLAlchemy database URL.
#   Local MySQL:      mysql+pymysql://USER:PASSWORD@localhost:3306/smartpossystem
#   Postgres (Render): postgresql://USER:PASSWORD@HOST:5432/DBNAME
# (Render's postgres:// URLs are auto-normalized to postgresql:// in database.py.)
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/smartpossystem

# --- Auth / JWT ---
# Secret used to sign JWT access tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. If unset, the server falls back to an ephemeral key
# (all tokens are invalidated on every restart).
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Access-token lifetime in days (default: 7).
JWT_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed browser origins for the web frontend.
# Native mobile builds are unaffected by CORS. Set this to your deployed web origin(s).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# --- Timezone ---
# Business timezone for sales bounds, invoices, and analytics (default: Asia/Kolkata).
APP_TIMEZONE=Asia/Kolkata

